# PostgreSQL for local Docker Compose. Copy to .env and choose a password.
POSTGRES_DB=ngapsense
POSTGRES_USER=ngapsense
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5432

# FastAPI runs on the host. Keep this URL consistent with POSTGRES_* above.
# Percent-encode reserved characters in the URL's password (for example @ -> %40).
DATABASE_URL=postgresql+psycopg://ngapsense:change_me_local@127.0.0.1:5432/ngapsense

# The existing MQTT listener uses backend/.env (see backend/.env.example).
# Streamlit remains a placeholder and does not connect to FastAPI or PostgreSQL.
